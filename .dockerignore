# Git
.git
.gitignore
.gitattributes

# Rust
target/
**/*.rs.bk
*.pdb
# Note: Cargo.lock should be included for reproducible builds

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Documentation
*.md
!README.md
docs/
architecture/
proposals/

# Logs
*.log
logs/
cli_debug.log

# Test files, but keep workspace members cargo needs to parse the workspace.
tests/*
!tests/workflow_harness/
!tests/workflow_harness/**
**/*_test.rs
**/test_*.rs
**/bin/test_*.rs

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/

# Runtime config, secrets, and report exports are mounted at run time.
# Gitignore does not keep them out of `docker build` context.
config/
secrets/
trading_keys/
runtime-data/
**/.env
**/*.pem
# Do not use **/*secret* — that excludes source files such as secret.rs.
**/*secret*.json
**/*secret*.env
**/*secret*.txt
**/secrets/**

# Scripts, but keep the workspace member.
scripts/*
!scripts/deepbook/
!scripts/deepbook/**

# Temporary files
tmp/
temp/
*.tmp

