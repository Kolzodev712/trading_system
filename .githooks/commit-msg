#!/usr/bin/env bash
# Strip / reject Cursor product trailers so commits stay human-authored only.
set -euo pipefail
msg_file="${1:?commit-msg file required}"

tmp="$(mktemp)"
# Drop Cursor co-author / generated-by lines (any casing).
grep -Eiv \
  '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor([[:space:]]*<[^>]*>)?[[:space:]]*$' \
  "$msg_file" \
| grep -Eiv \
  '^[[:space:]]*(Made with|Generated by|Signed-off-by:).*[Cc]ursor' \
  >"$tmp" || true

# Collapse trailing blank lines
# shellcheck disable=SC2016
awk 'NF{p=1} p' "$tmp" | awk '
  { lines[NR]=$0 }
  END {
    end=NR
    while (end>0 && lines[end] ~ /^[[:space:]]*$/) end--
    for (i=1; i<=end; i++) print lines[i]
  }
' >"$msg_file"
rm -f "$tmp"

if grep -Eiq 'Co-authored-by:[[:space:]]*Cursor|cursoragent@cursor\.com|Made with Cursor|Generated by Cursor' "$msg_file"; then
  echo "commit-msg: refusing commit message that mentions Cursor agent/product trailers" >&2
  exit 1
fi
