# OBSOLETE (2026-11-27): Incomplete workspace COPY vs current crate graph; previously
# suppressed a failed dependency build with `|| true`. Not a supported release path.
FROM rust:1.98-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./

# Copy workspace members
COPY libs/trading_core ./libs/trading_core
COPY cli ./cli

COPY . .

# Fail the image build if the package cannot compile (do not suppress errors).
RUN cargo build --release --package cli --bin trading-cli

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 appuser

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/trading-cli /app/trading-cli

# Create logs directory
RUN mkdir -p /app/logs && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Note: TUI CLI is interactive and requires terminal
# Usage:
#   docker run -it --rm trading-system-cli [endpoint]
#   docker run -it --rm -e GRPC_ENDPOINT=http://trading-system:50051 trading-system-cli
# Default endpoint: http://trading-system:50051 (when using docker-compose network)

ENTRYPOINT ["/app/trading-cli"]

