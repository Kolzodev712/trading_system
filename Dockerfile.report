# One-shot trading-report observer. Does not start or restart runners.
FROM rust:1.98-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY . .
RUN cargo build --release -p trading_report --bin trading-report

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser
WORKDIR /app
COPY --from=builder /app/target/release/trading-report /app/trading-report
RUN mkdir -p /reports /journals && chown -R appuser:appuser /app /reports /journals
USER appuser
# No published ports. Journals and reports are bind-mounted at runtime.
ENTRYPOINT ["/app/trading-report"]
CMD ["--help"]
