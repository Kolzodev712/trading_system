# Copy to runtime-data/bybit-demo/operator.env (gitignored) and fill the token.
# Source it in the runner and grpc_ctl shells. Envoy must inject the same token.
export TRADING_OPERATOR_ID=bybit-demo
export TRADING_OPERATOR_TOKEN=
export TRADING_STRATEGY=BTCPriceMALongFlatV1
export TRADING_SYMBOL=BTC/USDT
export TRADING_GRPC=http://127.0.0.1:50051

# Real-signal Demo: leave these unset.
unset TRADING_TEST_CANDLES_PATH
unset TRADING_TEST_NOW_MS
unset INC10_FRESH_ENTRY_FIXTURE
