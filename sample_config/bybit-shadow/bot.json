{
  "system": {
    "log_level": "info",
    "shutdown_timeout_secs": 30
  },
  "execution_mode": "shadow",
  "shadow_journal_path": "runtime-data/shadow-journal.jsonl",
  "exchange_engine": {
    "exchange": "Bybit",
    "config": {
      "pairs": [
        {
          "base": "BTC",
          "quote": "USDT"
        }
      ],
      "instrumentType": "Futures",
      "credentials": {
        "apiKey": "xxxxxxxxxxxxxxxxxxxx",
        "apiSecret": "xxxxxxxxxxxxxxxxxxxx"
      },
      "testnet": false
    }
  },
  "server": {
    "bind_address": "0.0.0.0",
    "port": 8080
  },
  "redis": {
    "url": "",
    "enabled": false
  },
  "features": {
    "enable_reconciliation": true
  },
  "reconciliation": {
    "exchange_level_interval_ms": 180000,
    "trading_level_interval_ms": 180000,
    "enabled": true
  },
  "mongo": {
    "connection_string": "mongodb://localhost:27017",
    "database": "trading_system",
    "bot_id": "shadow_bot",
    "enabled": true
  }
}
